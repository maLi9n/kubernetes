---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: csa1
  namespace: codeserver
secrets:
  - name: csa1-token

---
apiVersion: v1
kind: Secret
metadata:
  name: csa1-token
  namespace: codeserver
  annotations:
    kubernetes.io/service-account.name: csa1
type: kubernetes.io/service-account-token

---
apiVersion: v1
kind: Service
metadata:
  name: codeserver
  namespace: codeserver
spec:
  selector:
    app: codeserver
  ports:
    - port: 8080
      targetPort: 8080
      protocol: TCP
  type: ClusterIP

---
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: codeserver
  namespace: codeserver
  annotations:
    kubernetes.io/ingress.class: traefik-external
spec:
  entryPoints:
    - websecure
  routes:
    - match: Host(`www.cs.cybertronlabs.us`)
      kind: Rule
      services:
        - name: codeserver
          port: 8080
    - match: Host(`cs.cybertronlabs.us`)
      kind: Rule
      services:
        - name: codeserver
          port: 8080
      middlewares:
        - name: default-headers
          namespace: traefik
        - name: rate-limit
          namespace: traefik
        - name: authentik-outpost
          namespace: traefik
#  tls:
#    secretName: cybertronlabs-tls # change to your cert name

