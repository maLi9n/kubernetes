#---
#apiVersion: v1
#kind: Namespace
#metadata:
#  name: codeserver

---
apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app: codeserver
    app.kubernetes.io/instance: codeserver
    app.kubernetes.io/name: codeserver
  name: codeserver
  namespace: codeserver
spec:
  replicas: 1
  selector:
    matchLabels:
      app: codeserver
  template:
    metadata:
      annotations:
        vault.hashicorp.com/agent-inject: "true"
        vault.hashicorp.com/agent-inject-status: "update"
        vault.hashicorp.com/role: "codeserver"
        vault.hashicorp.com/agent-inject-secret-env: "kv-v2/data/codeserver/secret"
        vault.hashicorp.com/agent-inject-template-env: |
          {{- with secret "kv-v2/data/codeserver/secret" -}}
          password={{ .Data.data.PASSWORD }}
          sudo_password={{ .Data.data.SUDO_PASSWORD }}
          proxy_domain={{ .Data.data.PROXY_DOMAIN }}
          {{- end }}
        vault.hashicorp.com/agent-inject-file-env: "/home/coder/.config/code-server/config.yaml"
      labels:
        app: codeserver
    spec:
      serviceAccountName: csa1
      nodeSelector:
        worker: "true"
      containers:
        - name: codeserver
          image: codercom/code-server:latest
          imagePullPolicy: Always
          ports:
            - containerPort: 8080
              name: https
              protocol: TCP
          env:
            - name: TZ
              value: "America/Chicago"
            - name: PUID
              value: "1000"
            - name: PGID
              value: "1000"
          volumeMounts:
            - name: codeserver
              mountPath: /config
            - name: vault-secrets
              mountPath: /home/coder/.config/code-server/
              readOnly: true
      volumes:
        - name: codeserver
          persistentVolumeClaim:
            claimName: codeserver
        - name: vault-secrets
          emptyDir: {}

